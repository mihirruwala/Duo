{
  "name": "duo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/features/studio/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/shared/database.generated.ts",
    "livekit": "bash scripts/livekit-dev.sh",
    "test:e2e:dev": "E2E_DEV=1 E2E_PORT=3200 playwright test",
    "ext:build": "node scripts/build-extension.mjs",
    "ext:build:e2e": "node scripts/build-extension.mjs --e2e",
    "studio:prepare": "node scripts/prepare-studio.mjs",
    "predev": "npm run studio:prepare",
    "prebuild": "node scripts/prepare-studio.mjs --minify"
  },
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "@mediapipe/tasks-vision": "1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
