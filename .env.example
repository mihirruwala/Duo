# ─────────────────────────────────────────────────────────────────────────────
# DUO environment. Copy to .env.local (never commit .env.local).
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app. Used for auth redirects. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → your project → Project Settings → Data API → "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_).
# Safe for the browser: all data access is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dashboard → Project Settings → API Keys → "Secret keys" → create/reveal (starts with sb_secret_).
# SERVER ONLY. Bypasses RLS; used for rate-limit counters. Never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── LiveKit (Milestone 2) ────────────────────────────────────────────────────
# Local dev: run `npm run livekit` (native livekit-server --dev) and keep these defaults.
# LiveKit Cloud: cloud.livekit.io → your project → Settings → Keys. URL looks like wss://<project>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# SERVER ONLY. Signs room access tokens.
LIVEKIT_API_SECRET=secret

# ── GIPHY (Milestone 3) ──────────────────────────────────────────────────────
# developers.giphy.com → Create an App → API → copy the API key. SERVER ONLY (proxied via /api/gifs).
GIPHY_API_KEY=

# ── Chrome extension (Milestone 4) ───────────────────────────────────────────
# chrome://extensions → DUO Control → "ID" (stable once the key in extension/manifest is set).
NEXT_PUBLIC_DUO_EXTENSION_ID=
